{
  "name": "honeyhole",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts *.json *.mjs *.mts playwright.config.ts",
    "db:init": "node --import tsx scripts/init-storage.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/point-to-line-distance": "7.4.0",
    "better-auth": "1.7.12",
    "better-sqlite3": "13.0.3",
    "leaflet": "1.9.4",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
