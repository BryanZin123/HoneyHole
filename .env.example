# No credentials required for current NOAA integration.
# Never commit secrets or expose them with a NEXT_PUBLIC_ prefix.
NEXT_TELEMETRY_DISABLED=1
# Future NWS identity configuration will be documented when implemented.
# NWS requires an application User-Agent; no API key currently required.
HONEYHOLE_USER_AGENT=HoneyHole/0.1 (https://github.com/BryanZin123/HoneyHole)

# Optional raster tiles; default OSM standard tiles. Review provider terms and update attribution before changing.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Local single-host accounts: npm run db:init. Use the exact browser origin.
BETTER_AUTH_URL=http://localhost:3000
HONEYHOLE_DATA_DIR=.data
# Optional >=32-character random server secret; otherwise init writes a private secret file.
# BETTER_AUTH_SECRET=
